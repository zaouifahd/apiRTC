generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  PROFESSIONAL
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PlaceStatus {
  DRAFT
  PUBLISHED
  CLAIMED
  SUSPENDED
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ProposalStatus {
  SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ReviewTargetType {
  PLACE
  PROFESSIONAL_PROFILE
  MISSION
  USER
}

enum BadgeCode {
  PHONE_VERIFIED
  IDENTITY_VERIFIED
  AFRITE_PRO
  FAST_RESPONDER
  TOP_RATED
  LOCAL_EXPERT
  TRUSTED_NEIGHBOR
}

model User {
  id              String             @id @default(cuid())
  name            String?
  email           String?            @unique
  emailVerified   DateTime?
  image           String?
  phone           String?            @unique
  phoneVerifiedAt DateTime?
  role            UserRole           @default(USER)
  city            String?
  wilaya          String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  accounts        Account[]
  sessions        Session[]
  profile         ProfessionalProfile?
  places          Place[]            @relation("PlaceOwner")
  reviews         Review[]           @relation("ReviewAuthor")
  requests        ServiceRequest[]   @relation("RequestAuthor")
  proposals       Proposal[]
  messages        Message[]
  badges          UserBadge[]
  reputation      ReputationScore?
  verifications   IdentityVerification[]
  media           MediaAsset[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  module      String
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  places      Place[]
  profiles    ProfessionalProfile[]
  requests    ServiceRequest[]
  createdAt   DateTime   @default(now())
}

model Place {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  description   String?      @db.Text
  aiSummary     String?      @db.Text
  status        PlaceStatus  @default(DRAFT)
  categoryId    String
  ownerId       String?
  address       String?
  city          String
  wilaya        String
  latitude      Float
  longitude     Float
  phone         String?
  website       String?
  priceLevel    Int?
  averageRating Float        @default(0)
  reviewCount   Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  category      Category     @relation(fields: [categoryId], references: [id])
  owner         User?        @relation("PlaceOwner", fields: [ownerId], references: [id])
  hours         OpeningHour[]
  media         MediaAsset[]
  reviews       Review[]
  embeddings    Embedding[]

  @@index([city, wilaya])
  @@index([latitude, longitude])
}

model OpeningHour {
  id        String  @id @default(cuid())
  placeId   String
  dayOfWeek Int
  opensAt   String
  closesAt  String
  place     Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, dayOfWeek, opensAt])
}

model ProfessionalProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  categoryId          String
  headline            String
  bio                 String?            @db.Text
  city                String
  wilaya              String
  serviceRadiusKm     Int                @default(20)
  hourlyRateDzd       Int?
  verifiedStatus      VerificationStatus @default(PENDING)
  isAfritePro         Boolean            @default(false)
  averageRating       Float              @default(0)
  reviewCount         Int                @default(0)
  completedMissions   Int                @default(0)
  responseRate        Float              @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            Category           @relation(fields: [categoryId], references: [id])
  portfolio           PortfolioItem[]
  reviews             Review[]
  embeddings          Embedding[]

  @@index([city, wilaya])
}

model PortfolioItem {
  id        String              @id @default(cuid())
  profileId String
  title     String
  body      String?             @db.Text
  mediaUrl  String?
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())
}

model ServiceRequest {
  id          String        @id @default(cuid())
  authorId    String
  categoryId  String
  title       String
  description String        @db.Text
  city        String
  wilaya      String
  latitude    Float?
  longitude   Float?
  budgetMin   Int?
  budgetMax   Int?
  dueAt       DateTime?
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  author      User          @relation("RequestAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category    Category      @relation(fields: [categoryId], references: [id])
  proposals   Proposal[]
  messages    Message[]
  reviews     Review[]
  embeddings  Embedding[]

  @@index([status, city, wilaya])
}

model Proposal {
  id          String         @id @default(cuid())
  requestId   String
  authorId    String
  priceDzd    Int?
  message     String         @db.Text
  status      ProposalStatus @default(SENT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([requestId, authorId])
}

model Message {
  id        String         @id @default(cuid())
  requestId String
  senderId  String
  body      String         @db.Text
  readAt    DateTime?
  createdAt DateTime       @default(now())
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender    User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Review {
  id            String            @id @default(cuid())
  authorId      String
  placeId       String?
  profileId     String?
  requestId     String?
  targetType    ReviewTargetType
  rating        Int
  body          String?           @db.Text
  aiSignals     Json?
  isSuspicious  Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  author        User              @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  place         Place?            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  profile       ProfessionalProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  request       ServiceRequest?   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([targetType, rating])
}

model Badge {
  id          String      @id @default(cuid())
  code        BadgeCode   @unique
  label       String
  description String
  users       UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

model ReputationScore {
  userId            String   @id
  score             Int      @default(0)
  averageRating     Float    @default(0)
  completedMissions Int      @default(0)
  satisfactionRate  Float    @default(0)
  responseRate      Float    @default(0)
  verifiedIdentity  Boolean  @default(false)
  computedAt        DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IdentityVerification {
  id        String             @id @default(cuid())
  userId    String
  status    VerificationStatus @default(PENDING)
  provider  String?
  metadata  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id        String   @id @default(cuid())
  ownerId   String
  placeId   String?
  url       String
  mimeType  String
  alt       String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  place     Place?   @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model Embedding {
  id        String   @id @default(cuid())
  objectType String
  objectId   String
  placeId    String?
  profileId  String?
  requestId  String?
  model      String
  vector     Unsupported("vector")?
  text       String   @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())
  place      Place?   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  profile    ProfessionalProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  request    ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([objectType, objectId])
}

model SearchQueryLog {
  id        String   @id @default(cuid())
  userId    String?
  query     String
  city      String?
  wilaya    String?
  intent    String?
  filters   Json?
  createdAt DateTime @default(now())
}
