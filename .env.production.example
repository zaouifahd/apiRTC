# Domaine public du VPS, sans protocole. Exemple: afrite.dz ou app.afrite.dz
DOMAIN="afrite.example.com"

# Next/Auth
NEXTAUTH_URL="https://afrite.example.com"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# PostgreSQL interne Docker
POSTGRES_DB="afrite"
POSTGRES_USER="afrite"
POSTGRES_PASSWORD="replace-with-a-strong-postgres-password"
DATABASE_URL="postgresql://afrite:replace-with-a-strong-postgres-password@postgres:5432/afrite?schema=public"

# Meilisearch interne Docker
MEILI_MASTER_KEY="replace-with-a-strong-meili-key"
MEILISEARCH_HOST="http://meilisearch:7700"
MEILISEARCH_API_KEY="replace-with-a-strong-meili-key"

# MinIO/S3 interne Docker
MINIO_ROOT_USER="afrite"
MINIO_ROOT_PASSWORD="replace-with-a-strong-minio-password"
S3_ENDPOINT="http://minio:9000"
S3_BUCKET="afrite-media"
S3_ACCESS_KEY_ID="afrite"
S3_SECRET_ACCESS_KEY="replace-with-a-strong-minio-password"

# APIs externes
OPENAI_API_KEY=""
MAPBOX_TOKEN=""
